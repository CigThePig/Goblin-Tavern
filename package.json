{
  "name": "goblin-tavern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs --tier=fast",
    "test:full": "node scripts/run-tests.mjs --tier=all",
    "test:heavy": "node scripts/run-tests.mjs --tier=heavy",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.web.json",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sample:card-choices": "tsx scripts/sample-card-choices.ts",
    "audit:card-choices": "tsx scripts/audit-card-choices.ts",
    "audit:cause-coverage": "tsx scripts/true-gaps-audit.ts",
    "balance:matrix": "tsx scripts/balance-matrix.ts",
    "ledger:check": "tsx scripts/expansion-ledger.ts",
    "baseline:probes": "tsx scripts/expansion-baseline.ts",
    "repo:map": "tsx scripts/expansion-repo-map.ts",
    "progression:lab": "node --import tsx scripts/progression-lab.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20.11.0",
    "jsdom": "^24.1.3",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "prando": "^6.0.1",
    "zod": "^4.4.3"
  }
}
