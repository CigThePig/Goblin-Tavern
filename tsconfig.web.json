{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "node"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true
  },
  "include": ["web/**/*.ts", "web/**/*.svelte", "src/sim/**/*.ts"]
}
